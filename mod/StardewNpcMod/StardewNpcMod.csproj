<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StardewNpcMod</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <!-- Shadow mode: compile only. Never deploy into the game's Mods folder or zip. -->
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <EnableGameDebugging>false</EnableGameDebugging>
    <!-- Read-only Harmony postfixes (docs/spec/diary.md, "Harmony"): adds the reference only;
         SMAPI 4.5.2 ships Harmony 2.2.2 and needs no opt-in at runtime. -->
    <EnableHarmony>true</EnableHarmony>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.1" />
    <ProjectReference Include="..\..\src\NpcSchedules\NpcSchedules.csproj" />
    <ProjectReference Include="..\..\src\NpcMemory\NpcMemory.csproj" />
    <ProjectReference Include="..\..\src\NpcDecision\NpcDecision.csproj" />
    <ProjectReference Include="..\..\src\NpcIntents\NpcIntents.csproj" />
    <ProjectReference Include="..\..\src\NpcInitiation\NpcInitiation.csproj" />
    <ProjectReference Include="..\..\src\NpcDiaryEvents\NpcDiaryEvents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\regions.json" Link="regions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
