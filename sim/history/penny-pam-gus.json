  "accounts": [
    {
      "id": "ppga-penny-saloon",
      "factId": "ppga-saloon-practice",
      "holder": "Penny",
      "text": "Pam often goes to the Saloon. I keep cleaning and doing the dishes alone; I connect her headaches and lack of help to those late nights.",
      "how": "Inferred",
      "sources": [
        "ppg-source-penny-mon4",
        "ppg-source-penny-fri4",
        "ppg-source-penny-sun4"
      ],
      "cues": [
        {
          "key": "person:Pam",
          "sourceId": "ppg-source-penny-fri4"
        },
        {
          "key": "place:Saloon",
          "sourceId": "ppg-source-penny-mon4"
        },
        {
          "key": "place:Home:Trailer"
        },
        {
          "key": "time:evening"
        },
        {
          "key": "situation:household-work"
        }
      ]
    },
    {
      "id": "ppga-pam-saloon",
      "factId": "ppga-saloon-practice",
      "holder": "Pam",
      "text": "I keep returning to the Saloon and look forward to a drink. I also think that ending up there so often is unhealthy, and wish I had another hobby; perhaps checkers on my own.",
      "how": "Lived",
      "sources": [
        "ppg-source-pam-saloon",
        "ppg-source-pam-saloon-entry",
        "ppg-source-pam-saloon-thu",
        "ppg-source-pam-summer-thu4",
        "ppg-source-pam-fri2"
      ],
      "cues": [
        {
          "key": "place:Saloon",
          "sourceId": "ppg-source-pam-saloon"
        },
        {
          "key": "person:Gus",
          "sourceId": "ppg-source-pam-saloon-entry"
        },
        {
          "key": "time:evening"
        },
        {
          "key": "activity:PlayedGame"
        },
        {
          "key": "wish:activity:PlayedGame"
        }
      ]
    },
    {
      "id": "ppga-gus-saloon",
      "factId": "ppga-saloon-practice",
      "holder": "Gus",
      "text": "Pam and Clint are regular evening customers. Their custom helps keep my business going. I see Pam drink too much beer and remind myself not to judge my customers.",
      "how": "Witnessed",
      "sources": [
        "ppg-source-gus-thu",
        "ppg-source-gus-sun",
        "ppg-source-gus-thu8"
      ],
      "cues": [
        {
          "key": "person:Pam",
          "sourceId": "ppg-source-gus-thu8"
        },
        {
          "key": "place:Saloon",
          "sourceId": "ppg-source-gus-thu"
        },
        {
          "key": "time:evening"
        }
      ]
    },
    {
      "id": "ppga-penny-care",
      "factId": "ppgf-penny-care",
      "holder": "Penny",
      "text": "I worry that my mother does not look after herself. I want her to be happy, but that worry burdens me and I want a life outside this home.",
      "how": "Lived",
      "sources": [
        "ppg-source-penny-fall-thu6",
        "ppg-source-penny-mon8"
      ],
      "cues": [
        {
          "key": "person:Pam",
          "sourceId": "ppg-source-penny-fall-thu6"
        },
        {
          "key": "place:Home:Trailer"
        }
      ]
    },
    {
      "id": "ppga-pam-pride",
      "factId": "ppgf-pam-pride",
      "holder": "Pam",
      "text": "Penny is my only child. I want people to treat her kindly, hope she has a good life, and feel glad that she is clever and loves books.",
      "how": "Lived",
      "sources": [
        "ppg-source-pam-fall-thu",
        "ppg-source-pam-winter-tue4",
        "ppg-source-pam-winter-fri"
      ],
      "cues": [
        {
          "key": "person:Penny",
          "sourceId": "ppg-source-pam-fall-thu"
        },
        {
          "key": "place:Home:Trailer"
        }
      ]
    },
    {
      "id": "ppga-penny-reading",
      "factId": "ppgf-penny-reading",
      "holder": "Penny",
      "text": "Reading helps me set aside the difficulties of my life for a while.",
      "how": "Lived",
      "sources": [
        "ppg-source-penny-thu"
      ],
      "cues": [
        {
          "key": "activity:Reading",
          "sourceId": "ppg-source-penny-thu"
        }
      ]
    },
    {
      "id": "ppga-penny-teaching",
      "factId": "ppgf-penny-teaching",
      "holder": "Penny",
      "text": "I teach Vincent and Jas and try to give them opportunities to do well.",
      "how": "Lived",
      "sources": [
        "ppg-source-penny-wed"
      ],
      "cues": [
        {
          "key": "activity:Teaching",
          "sourceId": "ppg-source-penny-wed"
        },
        {
          "key": "person:Vincent",
          "sourceId": "ppg-source-penny-wed"
        },
        {
          "key": "person:Jas",
          "sourceId": "ppg-source-penny-wed"
        }
      ]
    },
    {
      "id": "ppga-penny-father-left",
      "factId": "ppgf-penny-father-left",
      "holder": "Penny",
      "text": "My father left when I was a child. He said he felt trapped, and we have not seen him since. Autumn brings this memory back.",
      "how": "Lived",
      "sources": [
        "ppg-source-penny-fall-fri6"
      ],
      "cues": [
        {
          "key": "season:fall",
          "sourceId": "ppg-source-penny-fall-fri6"
        }
      ]
    },
    {
      "id": "ppga-pam-truck-job",
      "factId": "ppgf-pam-truck-job",
      "holder": "Pam",
      "text": "I used to drive a truck around the valley, meeting people and listening to the radio. I miss that work.",
      "how": "Lived",
      "sources": [
        "ppg-source-pam-fall-sun4"
      ],
      "cues": [
        {
          "key": "activity:Travel",
          "sourceId": "ppg-source-pam-fall-sun4"
        },
        {
          "key": "activity:MeetingPeople",
          "sourceId": "ppg-source-pam-fall-sun4"
        },
        {
          "key": "activity:Radio",
          "sourceId": "ppg-source-pam-fall-sun4"
        }
      ]
    },
    {
      "id": "ppga-pam-bus-work-ended",
      "factId": "ppgf-pam-bus-work-ended",
      "holder": "Pam",
      "text": "I was laid off from my job driving the bus. I would like to have that work back.",
      "how": "Lived",
      "sources": [
        "ppg-source-pam-wed"
      ],
      "cues": [
        {
          "key": "activity:BusDriving",
          "sourceId": "ppg-source-pam-wed"
        }
      ]
    },
    {
      "id": "ppga-penny-bus-work-ended",
      "factId": "ppgf-pam-bus-work-ended",
      "holder": "Penny",
      "text": "Pam used to drive the bus, which stopped working. She is out of work, and saving money from my tutoring has been difficult.",
      "how": "Inferred",
      "sources": [
        "ppg-source-penny-summer-fri",
        "ppg-source-penny-tue4"
      ],
      "cues": [
        {
          "key": "person:Pam",
          "sourceId": "ppg-source-penny-tue4"
        },
        {
          "key": "activity:Teaching",
          "sourceId": "ppg-source-penny-tue4"
        }
      ]
    },
    {
      "id": "ppga-pam-gus-birthday",
      "factId": "ppgf-pam-gus-birthday",
      "holder": "Pam",
      "text": "Gus gives me beer on my birthday, and I think well of him.",
      "how": "Lived",
      "sources": [
        "ppg-source-pam-sun"
      ],
      "cues": [
        {
          "key": "person:Gus",
          "sourceId": "ppg-source-pam-sun"
        }
      ]
    }
  ],
